rules_version = '2';

// Baytna security rules. Deny by default; every read and write checks the caller's active membership.
// Layout and reasoning: docs/FIREBASE_SETUP.md and docs/DECISIONS.md (milestone 2).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function membershipPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/memberships/$(request.auth.uid);
    }

    function isMember(hid) {
      return signedIn() && exists(membershipPath(hid)) && get(membershipPath(hid)).data.status == 'ACTIVE';
    }

    function invitePath(hash) {
      return /databases/$(database)/documents/invites/$(hash);
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    // users/{uid}: which household this account belongs to. Only the account itself can see or change it,
    // and it only points at a household where the account really is a member.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId', 'memberId', 'updatedAt'])
        && request.resource.data.householdId is string
        && request.resource.data.memberId is string
        && request.resource.data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)/memberships/$(uid))
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)/memberships/$(uid)).data.memberId == request.resource.data.memberId;
      allow delete: if false;
    }

    match /households/{hid} {
      allow get: if isMember(hid);
      allow list: if false;
      // Created once, by its owner, together with the owner's membership.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(membershipPath(hid));
      allow update, delete: if false;

      match /memberships/{uid} {
        allow read: if isMember(hid);

        function validMembership() {
          let m = request.resource.data;
          return request.auth.uid == uid
            && m.keys().hasOnly(['uid', 'memberId', 'role', 'status', 'inviteId', 'joinedAt'])
            && m.keys().hasAll(['uid', 'memberId', 'role', 'status', 'inviteId', 'joinedAt'])
            && m.uid == uid
            && m.memberId is string
            && m.status == 'ACTIVE'
            && m.joinedAt == request.time;
        }

        // The household's creator, in the same batch that creates the household.
        function ownerBootstrap() {
          let m = request.resource.data;
          return m.role == 'OWNER' && m.inviteId == null
            && !exists(householdPath(hid))
            && getAfter(householdPath(hid)).data.ownerUid == request.auth.uid;
        }

        // A partner holding an unused, unexpired, unrevoked invite for this household, consumed in the same write.
        function inviteJoin() {
          let m = request.resource.data;
          let before = get(invitePath(m.inviteId)).data;
          let after = getAfter(invitePath(m.inviteId)).data;
          return m.role == 'MEMBER' && m.inviteId is string
            && before.householdId == hid
            && before.usedBy == null
            && before.revoked == false
            && before.expiresAt > request.time
            && before.memberId == m.memberId
            && after.usedBy == request.auth.uid;
        }

        allow create: if signedIn() && validMembership() && (ownerBootstrap() || inviteJoin());
        allow update, delete: if false;
      }

      // One document per synced row: {type}_{id}. Versions only move forward by one; nothing is ever deleted
      // (deletions are tombstones), so every change is auditable and replayable.
      match /entities/{key} {
        allow read: if isMember(hid);

        function validEntity() {
          let d = request.resource.data;
          return d.keys().hasOnly(['type', 'id', 'householdId', 'version', 'deleted', 'payload', 'updatedBy', 'serverUpdatedAt', 'lastOpId'])
            && d.keys().hasAll(['type', 'id', 'householdId', 'version', 'deleted', 'payload', 'updatedBy', 'serverUpdatedAt', 'lastOpId'])
            && d.type in ['household', 'member', 'account', 'category', 'transaction', 'budget', 'budget_allocation',
                          'savings_goal', 'goal_contribution', 'recurring_rule', 'activity']
            && d.id is string && key == d.type + '_' + d.id
            && (d.type != 'household' || d.id == hid)
            && d.householdId == hid
            && d.version is int
            && d.deleted is bool
            && d.payload is string && d.payload.size() < 20000
            && d.updatedBy == request.auth.uid
            && d.serverUpdatedAt == request.time
            && d.lastOpId is string
            // The operation must be recorded in the same write, which is what makes retries idempotent.
            && existsAfter(/databases/$(database)/documents/households/$(hid)/ops/$(d.lastOpId))
            && !exists(/databases/$(database)/documents/households/$(hid)/ops/$(d.lastOpId));
        }

        allow create: if isMember(hid) && validEntity() && request.resource.data.version == 1;
        allow update: if isMember(hid) && validEntity()
          && request.resource.data.version == resource.data.version + 1
          // Activity entries (who changed what) are written once and never edited.
          && resource.data.type != 'activity'
          && request.resource.data.type == resource.data.type
          && request.resource.data.id == resource.data.id;
        allow delete: if false;
      }

      // Processed operation ids. Write-once.
      match /ops/{opId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.keys().hasOnly(['entityKey', 'by', 'at'])
          && request.resource.data.entityKey is string
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // invites/{sha256 of code}. The code itself is never stored. Reading one needs the hash, which only the code's
    // holder (or a member listing their own household's invites) can know.
    match /invites/{hash} {
      allow get: if signedIn();
      allow list: if signedIn() && isMember(resource.data.householdId);
      allow create: if signedIn()
        && isMember(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(['householdId', 'memberId', 'createdBy', 'createdAt', 'expiresAt', 'revoked', 'usedBy', 'usedAt'])
        && request.resource.data.keys().hasAll(['householdId', 'memberId', 'createdBy', 'createdAt', 'expiresAt', 'revoked', 'usedBy', 'usedAt'])
        && request.resource.data.memberId is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && request.resource.data.revoked == false
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null;
      allow update: if signedIn() && (
        // Revoke: any member of the household.
        (isMember(resource.data.householdId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true)
        ||
        // Consume: once, before expiry, together with creating the caller's membership.
        (resource.data.usedBy == null
          && resource.data.revoked == false
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt == request.time
          && existsAfter(/databases/$(database)/documents/households/$(resource.data.householdId)/memberships/$(request.auth.uid)))
      );
      allow delete: if false;
    }
  }
}
